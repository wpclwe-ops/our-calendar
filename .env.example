# Production: fill in the hosting service's secret variables, never commit real values.
BOT_TOKEN=
BOT_USERNAME=
PUBLIC_URL=https://your-service.example
SESSION_SECRET=
WEBHOOK_SECRET=
DATABASE_PATH=/data/calendar.sqlite3
ARCHIVE_KEY_FILE=/data/archive-key.pem
ARCHIVE_PUBLIC_KEYS=/data/archive-public-keys.json
DEMO_MODE=false
HOST=0.0.0.0
PORT=8000

# Self-hosted/trusted LibreTranslate base URL, without /translate.
# HTTPS externally, or http://calendar-translate.railway.internal:5000 privately in Railway.
# Event text is sent only to the endpoint you configure here.
TRANSLATION_URL=
TRANSLATION_API_KEY=

# Closed setup screen until all required production variables are supplied.
SETUP_MODE=false
# Verify the bot username and register webhook/menu on worker startup.
AUTO_SETUP_BOT=true

# Optional encrypted daily operator backups in private S3 storage (7-day retention).
# Set all six values together. Keep the Fernet key outside the persistent volume.
OPERATOR_BACKUP_ENDPOINT=
OPERATOR_BACKUP_BUCKET=
OPERATOR_BACKUP_REGION=auto
OPERATOR_BACKUP_ACCESS_KEY=
OPERATOR_BACKUP_SECRET_KEY=
OPERATOR_BACKUP_KEY=

# Fail closed before startup until database + signing keys are copied locally
# and the encrypted remote release checkpoint passes a restore test.
RELEASE_CHECKPOINT_REQUIRED=false

# Google read-only calendar import (OAuth) and optional iCloud credentials encryption.
# Generate each Fernet key separately and store only in Railway/server secrets.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CREDENTIAL_KEY=
# Optional: if unset, iCloud falls back to GOOGLE_CREDENTIAL_KEY.
ICLOUD_CREDENTIAL_KEY=

# Optional Smart Events. Separate OpenAI API billing; never expose this key to the client.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
SMART_MONTHLY_BUDGET_USD=5
OPENAI_MAX_OUTPUT_TOKENS=16384
# Set false to pause automatic assignment. Both users must also choose auto mode.
SMART_AUTO_CATEGORIES_ENABLED=true
